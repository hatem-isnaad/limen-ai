# Limen AI environment guide
# Copy the variables you need into .env

LIMEN_AI_DEFAULT_AGENT=example
LIMEN_AI_PROVIDER=fake
LIMEN_AI_EXAMPLE_AGENT_ENABLED=true
LIMEN_AI_EXAMPLE_MODEL=gpt-4.1-mini

# OpenAI
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4096

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=

# UI / runtime
LIMEN_AI_UI_ENABLED=true
LIMEN_AI_ROUTE_PREFIX=limen-ai
LIMEN_AI_QUEUE_AGENT_RUNS=false
LIMEN_AI_BROADCASTING_ENABLED=true
LIMEN_AI_USAGE_TRACKING_ENABLED=true
